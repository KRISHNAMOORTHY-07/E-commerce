rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function admin() {
      return request.auth != null &&
        get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /users/{id} {
      allow read: if request.auth != null && (request.auth.uid == id || admin());
      allow create: if request.auth != null && request.auth.uid == id && request.resource.data.role == 'customer';
      allow update, delete: if admin();
    }
    match /rates/{id}    { allow read: if true; allow write: if admin(); }
    match /settings/{id} { allow read: if true; allow write: if admin(); }
    match /customers/{id} {
      allow read: if request.auth != null && (request.auth.uid == id || admin());
      allow create: if admin() || (request.auth != null && request.auth.uid == id && request.resource.data.type == 'retail');
      allow update, delete: if admin();
    }
    match /ledger/{id} {
      allow read: if request.auth != null && (resource.data.customerId == request.auth.uid || admin());
      allow write: if admin();
    }
    match /orders/{id} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || admin());
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'new';
      allow update, delete: if admin();
    }
    match /expenses/{id} { allow read, write: if admin(); }
  }
}
